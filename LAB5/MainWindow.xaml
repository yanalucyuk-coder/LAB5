<Window x:Class="LAB5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LAB5"
        mc:Ignorable="d"
        Title="Список студентів" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Додати студента" FontWeight="Bold"/>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="ПІБ:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="FullNameTextBox" Grid.Row="0" Grid.Column="1" Margin="5" Padding="2"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Рік народження:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="BirthYearTextBox" Grid.Row="0" Grid.Column="3" Margin="5" Padding="2"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Школа:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="SchoolTextBox" Grid.Row="1" Grid.Column="1" Margin="5" Padding="2"/>

            </Grid>
            <Button x:Name="AddButton" Content="Додати студента" Margin="5" Click="AddButton_Click"/>
        </StackPanel>
        <DataGrid x:Name="StudentsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ПІБ" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Рік народження" Binding="{Binding BirthYear}" Width="Auto"/>
                <DataGridTextColumn Header="Школа" Binding="{Binding NameOfSchool}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <TextBlock Text="Школа для фільтра:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="FilterSchoolTextBox" Width="150" Margin="5" Padding="2"/>
            <Button x:Name="FilterButton" Content="Фільтр" Margin="5" Click="FilterButton_Click"/>
            <Button x:Name="ResetFilterButton" Content="Скинути фільтр" Margin="5" Click="ResetFilterButton_Click"/>
            <Button x:Name="DeleteButton" Content="Видалити" Margin="5" Click="DeleteButton_Click"/>
            <Button x:Name="SortByBirthYearButton" Content="Сортувати за роком" Margin="5" Click="SortByBirthYearButton_Click"/>
            <Button x:Name="LoadButton" Content="Завантажити" Margin="5" Click="LoadButton_Click"/>
            <Button x:Name="SaveButton" Content="Зберегти" Margin="5" Click="SaveButton_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
            <TextBlock Text="Пошук:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="SearchTextBox" Width="200" Margin="5" Padding="2"/>
            <Button x:Name="SearchButton" Content="Пошук" Margin="5" Click="SearchButton_Click"/>
            <Button x:Name="UniqueSchoolsButton" Content="Унікальні школи" Margin="5" Click="UniqueSchoolsButton_Click"/>
            <Button x:Name="ThreeOldestButton" Content="3 найстарші" Margin="5" Click="ThreeOldestButton_Click"/>
            <Button x:Name="AverageBirthYearButton" Content="Середній рік" Margin="5" Click="AverageBirthYearButton_Click"/>
            <Button x:Name="GroupBySchoolButton" Content="Групування за школою" Margin="5" Click="GroupBySchoolButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
